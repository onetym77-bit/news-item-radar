{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onetym77-bit/news-item-radar/multi-agent-shadow-v1/schemas/candidate_assessment.schema.json",
  "title": "Multi-agent shadow candidate assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_role",
    "snapshot_id",
    "candidate_id",
    "issue_title",
    "issue_summary",
    "evidence_refs",
    "citizen_stake",
    "structural_mechanism",
    "editorial_tension",
    "confirmed_facts",
    "unverified_claims",
    "competing_hypotheses",
    "verification_plan",
    "kill_criteria",
    "scores",
    "score_total",
    "grounding_level",
    "verdict",
    "recommended_lane",
    "scope_warning",
    "reasoning_summary"
  ],
  "properties": {
    "schema_version": {"const": "candidate-assessment-v1"},
    "agent_role": {
      "enum": [
        "DISCOVERY_PUBLIC",
        "DISCOVERY_CITIZEN",
        "DISCOVERY_STRUCTURE",
        "EDITOR",
        "SKEPTIC",
        "BACKFILL",
        "ORCHESTRATOR"
      ]
    },
    "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "issue_title": {"type": "string", "minLength": 1, "maxLength": 160},
    "issue_summary": {"type": "string", "minLength": 1, "maxLength": 800},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_id", "source_id", "url", "exact_text", "claim_status"],
        "properties": {
          "ref_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "exact_text": {"type": "string", "minLength": 1, "maxLength": 1600},
          "claim_status": {
            "enum": ["OBSERVED_OR_PUBLISHED", "ATTRIBUTED_CLAIM", "UNRESOLVED"]
          }
        }
      }
    },
    "citizen_stake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected_group", "loss_type", "consequence"],
      "properties": {
        "affected_group": {"type": "string", "minLength": 1, "maxLength": 240},
        "loss_type": {
          "enum": ["MONEY", "TIME", "SAFETY", "RIGHTS", "ACCESS", "CHOICE", "MULTIPLE"]
        },
        "consequence": {"type": "string", "minLength": 1, "maxLength": 600}
      }
    },
    "structural_mechanism": {"type": "string", "minLength": 1, "maxLength": 800},
    "editorial_tension": {"type": "string", "minLength": 1, "maxLength": 600},
    "confirmed_facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourcedStatement"}
    },
    "unverified_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourcedStatement"}
    },
    "competing_hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "explanation", "discriminating_evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 600},
          "discriminating_evidence": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "verification_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "source_family", "pass_signal"],
        "properties": {
          "action": {"type": "string", "minLength": 1, "maxLength": 500},
          "source_family": {
            "enum": ["PUBLIC", "PRICE", "BEHAVIOR", "VOICE", "FIELD", "INDUSTRY", "MEDIA", "SOCIAL"]
          },
          "pass_signal": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    },
    "kill_criteria": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 400}
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tension_surprise",
        "citizen_loss_rights",
        "distribution_exclusion",
        "competing_hypotheses",
        "accountability_change",
        "falsification_decision_line"
      ],
      "properties": {
        "tension_surprise": {"type": "integer", "minimum": 0, "maximum": 2},
        "citizen_loss_rights": {"type": "integer", "minimum": 0, "maximum": 2},
        "distribution_exclusion": {"type": "integer", "minimum": 0, "maximum": 2},
        "competing_hypotheses": {"type": "integer", "minimum": 0, "maximum": 2},
        "accountability_change": {"type": "integer", "minimum": 0, "maximum": 2},
        "falsification_decision_line": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "score_total": {"type": "integer", "minimum": 0, "maximum": 12},
    "grounding_level": {
      "enum": ["G0_UNGROUNDED", "G1_ATTRIBUTED_CLAIM", "G2_SUPPORTING_RECORD", "G3_INDEPENDENT_CORROBORATION"]
    },
    "verdict": {"enum": ["PASS", "HOLD", "FAIL"]},
    "recommended_lane": {
      "enum": ["QUESTION_RAW", "VERIFY_TODAY", "EDITORIAL_PROPOSAL", "REJECT"]
    },
    "scope_warning": {"type": "string", "maxLength": 500},
    "reasoning_summary": {"type": "string", "minLength": 1, "maxLength": 800}
  },
  "$defs": {
    "sourcedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_ref_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 600},
        "source_ref_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
